# ============================================================
# Curso de Eletricista (learis.com.br) - modelo de .env
# Copie este arquivo para ".env" e preencha. NUNCA versione o .env.
# ============================================================

# Porta do servidor local
PORT=3000

# URL publica do site (usada nos links de e-mail e no webhook do PagBank)
# Local: http://localhost:3000
# Producao: https://learis.com.br
PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# Banco de dados - Supabase
# Painel: Project Settings > API
# A "service_role" e secreta: use SOMENTE no servidor, nunca no navegador.
# ------------------------------------------------------------
SUPABASE_URL=https://vvsyquozzttiivgsswfz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# PagBank (Pix) - integracao automatica (opcional/legado)
# Mantido por compatibilidade; o fluxo atual usa Pix fixo com liberacao manual.
# ------------------------------------------------------------
PAGBANK_ENV=production
PAGBANK_TOKEN=
# Opcional: sobrescreve a URL do webhook (padrao: PUBLIC_BASE_URL/api/pagbank/webhook).
PAGBANK_WEBHOOK_URL=
# Validade do QR Code em minutos (padrao: 30)
PAGBANK_EXPIRACAO_MINUTOS=30

# ------------------------------------------------------------
# Pix fixo (manual) - usado pelo fluxo atual de pagamento
# O aluno paga no QR/copia e cola fixo e o admin libera o acesso manualmente.
# ------------------------------------------------------------
PIX_CHAVE_FIXA=18125a2a-480d-43fe-a3e6-1f6e1f1414e1
PIX_RECEBEDOR_NOME=CURSO ELETRICISTA
PIX_RECEBEDOR_CIDADE=SAO PAULO
# Link do WhatsApp do admin para envio do comprovante (ex.: https://wa.me/55DDDNUMERO)
WHATSAPP_ADMIN_URL=
# Senha da area administrativa (/admin.html) para liberar acessos manualmente
ADMIN_SENHA=

# ------------------------------------------------------------
# E-mail transacional (Resend) - opcional em desenvolvimento
# Sem a chave, os links de confirmacao aparecem no console do servidor.
# ------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Curso de Eletricista <no-reply@learis.com.br>

# ------------------------------------------------------------
# Produto
# ------------------------------------------------------------
VALOR_ACESSO=16.9
DESCRICAO_PAGAMENTO=Curso de Eletricista - Acesso completo
SESSAO_DIAS=30

# ------------------------------------------------------------
# Ambiente
# NODE_ENV=production em producao (desativa o modo de teste)
# ALLOW_DEV_PAYMENT=1 libera o botao "Simular pagamento" SOMENTE fora de producao
# ------------------------------------------------------------
NODE_ENV=development
ALLOW_DEV_PAYMENT=1
