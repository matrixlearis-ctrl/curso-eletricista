{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "private/**"]
      }
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
